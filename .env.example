# Copy to .env:  cp .env.example .env
# Defaults work for local (npm run dev) runs. docker-compose.yml reads this file too
# and overrides the values that differ inside containers (SMTP_HOST, PORT, TRUST_PROXY).

# --- Backend ---
PORT=3000
FAKESTORE_BASE_URL=https://fakestoreapi.com
CACHE_TTL_SECONDS=300
# Number of reverse proxies in front of the API (0 locally; docker-compose sets 1 for nginx).
TRUST_PROXY=0

# The 5 products the owner has chosen as "top rated" for the home page (Fake Store ids).
FEATURED_PRODUCT_IDS=1,5,9,13,17

# Category page: a product is "top rated" if its rating (0-5) is at least the minimum;
# at most TOP_RATED_COUNT are shown, the rest appear under "More in this category".
TOP_RATED_COUNT=3
TOP_RATED_MIN_RATING=3

# Email. Locally this is Mailpit (inbox UI: http://localhost:8025), which needs no credentials.
# Production, e.g. SES: SMTP_HOST=email-smtp.<region>.amazonaws.com, SMTP_PORT=587, and the SES
# SMTP credentials in SMTP_USER/SMTP_PASS (set both or neither; TLS is then required).
# Never put real credentials in this file: use .env locally or a secrets manager in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=catalogue@example.com
SMTP_USER=
SMTP_PASS=
SALES_INBOX_EMAIL=sales@example.com

# --- Frontend (Vite dev server, local runs only) ---
# Where the Vite dev server proxies /api requests. In Docker, nginx does this instead.
API_PROXY_TARGET=http://localhost:3000
